---
import "../styles/global.css";
import {
  SITE_URL,
  SITE_NAME,
  DEFAULT_OG_IMAGE,
  OG_LOCALE,
  canonicalUrl,
  absoluteUrl,
  SITE_DESCRIPTOR,
  SERVICE_TYPES,
} from "../lib/seo";
import { HUB_PV_URL } from "../lib/hub";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_E164, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** Replaces the default Organization JSON-LD when provided. */
  schema?: Record<string, unknown>;
  ogType?: string;
  /** Extra robots directive, e.g. "noindex, follow" for confirmation pages. */
  robots?: string;
  /** Browser chrome color. Defaults to the site paper. */
  themeColor?: string;
  /** Hide the mobile action dock (pages that are already a form). */
  hideDock?: boolean;
}
const {
  title,
  description,
  path,
  ogImage = DEFAULT_OG_IMAGE,
  schema: pageSchema,
  ogType = "website",
  robots,
  themeColor = "#f6f1e7",
  hideDock = false,
} = Astro.props;
const origin = Astro.site?.origin ?? SITE_URL;
const canonical = canonicalUrl(path, origin);
const og = absoluteUrl(ogImage, origin);

// Organization schema only. No aggregateRating, no review count, no employee
// or client numbers: nothing here is a claim we cannot show evidence for
// (PROTOCOL 10).
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: SITE_NAME,
  alternateName: ["Arkansas Automated", "ArkansasAutomated.com"],
  url: origin,
  telephone: AA_PUBLIC_PHONE_E164,
  description,
  slogan: SITE_DESCRIPTOR,
  disambiguatingDescription:
    "Arkansas Automated tests and fixes how Arkansas home service businesses answer, follow up and get reviewed. Operated by Andre Brassfield in Fort Smith. Not affiliated with Arkansas Automated Security, LLC of Mayflower, a separate security and alarm installer.",
  founder: {
    "@type": "Person",
    name: "Andre Brassfield",
    jobTitle: "Founder",
    url: "https://arkansasautomated.com/about",
  },
  areaServed: [
    ...["Fort Smith", "Van Buren", "Russellville", "Fayetteville", "Springdale", "Rogers", "Bentonville", "Bella Vista", "Siloam Springs"].map(
      (name) => ({ "@type": "City", name: `${name}, Arkansas` }),
    ),
    { "@type": "AdministrativeArea", name: "River Valley, Arkansas" },
    { "@type": "AdministrativeArea", name: "Northwest Arkansas" },
    { "@type": "State", name: "Arkansas" },
  ],
  serviceType: SERVICE_TYPES,
};
const schema = pageSchema ?? defaultSchema;
// Entity disambiguation on every schema node, not just the default: pages
// that pass their own @graph with an Organization/ProfessionalService node
// (homepage, city and industry pages) would otherwise lose the fields that
// separate us from "Arkansas Automated Security, LLC" in knowledge graphs.
(function tagOrgNodes(node) {
  if (Array.isArray(node)) return node.forEach(tagOrgNodes);
  if (!node || typeof node !== "object") return;
  if (
    String(node["@type"]).match(/Organization|ProfessionalService/) &&
    !("legalName" in node)
  ) {
    node.alternateName = defaultSchema.alternateName;
  }
  Object.values(node).forEach(tagOrgNodes);
})(schema);
const pageviewEndpoint = import.meta.env.PROD ? HUB_PV_URL : "";
const siteHost = new URL(Astro.site?.origin ?? SITE_URL).hostname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <!-- ?v=2: Diamond A icons. Bump when the icons change so browsers drop the cached old mark. -->
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="theme-color" content={themeColor} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    {!hideDock && (
      <nav class="call-dock" aria-label="Quick actions">
        <a class="call-dock-test" href="/phone-test" data-cta="dock-phone-test">Free Phone Test</a>
        <a class="call-dock-call" href={AA_PUBLIC_PHONE_HREF} data-cta="dock-call">Call {AA_PUBLIC_PHONE_DISPLAY}</a>
      </nav>
    )}

    <script is:inline>
      // Attribution capture. First touch is kept for 90 days in localStorage;
      // last touch lives for the tab session. Every lead form reads both via
      // window.aaAttribution(). Storage can throw in private modes, so every
      // access is guarded and failure only loses attribution, never the page.
      (function () {
        var KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid", "gbraid", "wbraid", "fbclid", "msclkid"];
        var FT = "aa:ft", LT = "aa:lt", TTL = 90 * 864e5;
        function snapshot() {
          var p = new URLSearchParams(location.search), out = {};
          KEYS.forEach(function (k) { var v = p.get(k); if (v) out[k] = v.slice(0, 200); });
          out.landing = location.pathname;
          out.referrer = document.referrer && document.referrer.indexOf(location.host) === -1 ? document.referrer.slice(0, 300) : null;
          out.at = new Date().toISOString();
          return out;
        }
        var now = snapshot();
        var hasSignal = KEYS.some(function (k) { return now[k]; }) || now.referrer;
        try {
          var ft = JSON.parse(localStorage.getItem(FT) || "null");
          if (!ft || Date.now() - Date.parse(ft.at) > TTL) localStorage.setItem(FT, JSON.stringify(now));
        } catch (e) {}
        try {
          if (hasSignal || !sessionStorage.getItem(LT)) sessionStorage.setItem(LT, JSON.stringify(now));
        } catch (e) {}
        window.aaAttribution = function () {
          var ft = null, lt = null;
          try { ft = JSON.parse(localStorage.getItem(FT) || "null"); } catch (e) {}
          try { lt = JSON.parse(sessionStorage.getItem(LT) || "null"); } catch (e) {}
          return { firstTouch: ft, lastTouch: lt || now };
        };
      })();
    </script>

    <script define:vars={{ pageviewEndpoint, siteHost }}>
      // First-party pageview beacon into the hub. APEX host, never www: www
      // 308-redirects and a redirected cross-origin fetch resends with
      // Origin: null, which the hub allowlist rejects. Failure is silent by
      // design; measurement must never break a page.
      //
      // Host gate: only the canonical apex host is counted. astro dev, local
      // preview, and *.vercel.app previews are not production sessions.
      //
      // WHY THIS IS GATED (2026-08-08). The previous version fired
      // unconditionally on parse. That made every automated page load count as
      // a session, and the resulting number was not survivable as a conversion
      // denominator: over the 30 days to 2026-08-08 this domain recorded 222
      // pageviews, of which 133 carried referrer "https://www.google.com/"
      // while Search Console recorded 15 impressions and 2 clicks for the same
      // window. Google cannot send 133 visits it never served. Two of those
      // rows were paths (/assessment, /ai-tools-assessment) that have never
      // existed on this site, four seconds apart. The fleet's own agents also
      // land here: three loads on 2026-08-08 at 14:41 and 14:43 UTC were
      // written by an automated session whose navigator.webdriver reads false,
      // so a webdriver check does NOT filter them.
      //
      // What DOES separate them is that automated loads are rendered into a
      // page that never becomes visible. So the rule is: count a view only
      // once the page has been continuously visible for DWELL_MS, and only
      // once per path per tab session.
      //
      // TRADEOFFS, stated plainly:
      // - A human who leaves inside DWELL_MS is not counted. That is deliberate.
      //   A sub-second visible session cannot convert, so excluding it makes the
      //   conversion denominator honest rather than flattering.
      // - A human who opens this in a background tab is counted when they
      //   actually look at it, not when the tab was created.
      // - This is a heuristic, not proof of humanity. A headless browser that
      //   reports itself visible still counts. It removes a known, measured
      //   source of inflation; it does not make the number bot-proof.
      // - Counts after this ships are NOT comparable to counts before it. A
      //   drop is this filter working, not traffic disappearing.
      (function () {
        var ENDPOINT = pageviewEndpoint;
        if (!ENDPOINT) return;
        if (location.hostname !== siteHost) return;

        var DWELL_MS = 1500;
        var KEY = "aa:pv:" + location.pathname;

        // Once per path per tab session: reloads and hash navigation are not
        // new sessions. Private modes can throw on sessionStorage, so every
        // access is guarded and failure degrades to the old count-once-per-load.
        try {
          if (sessionStorage.getItem(KEY)) return;
        } catch (e) {
          /* storage unavailable; continue unguarded */
        }

        var timer = null;
        var sent = false;

        function send() {
          if (sent) return;
          sent = true;
          disarm();
          document.removeEventListener("visibilitychange", onVisibility);
          try {
            sessionStorage.setItem(KEY, "1");
          } catch (e) {
            /* no-op */
          }
          try {
            var params = new URLSearchParams(location.search);
            var referrer = document.referrer || null;
            // ChatGPT search puts utm_source=chatgpt.com on the landing URL.
            // Browsers often omit that query from document.referrer. Record it
            // in the existing referrer field only when the browser sent none.
            if (!referrer && params.get("utm_source") === "chatgpt.com") {
              referrer = "https://chatgpt.com/";
            }
            fetch(ENDPOINT, {
              method: "POST",
              headers: { "Content-Type": "text/plain" },
              body: JSON.stringify({
                path: location.pathname,
                referrer: referrer,
              }),
              keepalive: true,
            }).catch(function () {});
          } catch (e) {
            /* no-op */
          }
        }

        function arm() {
          if (sent || timer !== null) return;
          timer = window.setTimeout(send, DWELL_MS);
        }

        function disarm() {
          if (timer !== null) {
            clearTimeout(timer);
            timer = null;
          }
        }

        // Leaving before the dwell elapses resets it: the clock measures
        // continuous attention, not elapsed wall time with the tab buried.
        function onVisibility() {
          if (document.visibilityState === "visible") arm();
          else disarm();
        }

        document.addEventListener("visibilitychange", onVisibility);
        onVisibility();
      })();
    </script>
  </body>
</html>
