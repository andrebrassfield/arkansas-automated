---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PhoneTestHome, { homeFaqs } from "../components/PhoneTestHome.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_E164 } from "../lib/public-phone";
import { services, serviceHref } from "../data/services";
import { SITE_DESCRIPTOR, SERVICE_TYPES } from "../lib/seo";

const title = "Free Phone Test for Arkansas Home Service Businesses | Arkansas Automated";
const description =
  `We call your shop during the day and after hours, fill out your form, text your number and check your Google listing. Free score out of 100 within 3 days. Fort Smith and NWA. ${AA_PUBLIC_PHONE_DISPLAY}.`;

const site = "https://arkansasautomated.com";
const priceOf = (p: string) => (p.match(/\$([\d,]+)/)?.[1] ?? "0").replace(/,/g, "");

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${site}/#organization`,
      name: "Arkansas Automated",
      url: site,
      telephone: AA_PUBLIC_PHONE_E164,
      description: SITE_DESCRIPTOR,
      slogan: "Answered. Followed up. Reviewed.",
      disambiguatingDescription:
        "Arkansas Automated tests and fixes how Arkansas home service businesses answer, follow up and get reviewed. Operated by Andre Brassfield in Fort Smith. Not affiliated with Arkansas Automated Security, LLC of Mayflower, a separate security and alarm installer.",
      founder: { "@id": `${site}/about#andre-brassfield` },
      areaServed: [
        { "@type": "City", name: "Fort Smith, Arkansas" },
        { "@type": "City", name: "Van Buren, Arkansas" },
        { "@type": "City", name: "Rogers, Arkansas" },
        { "@type": "AdministrativeArea", name: "Northwest Arkansas" },
        { "@type": "State", name: "Arkansas" },
      ],
      serviceType: SERVICE_TYPES,
    },
    {
      "@type": "Person",
      "@id": `${site}/about#andre-brassfield`,
      name: "Andre Brassfield",
      jobTitle: "Founder",
      url: `${site}/about`,
      worksFor: { "@id": `${site}/#organization` },
    },
    {
      "@type": "WebSite",
      name: "Arkansas Automated",
      url: site,
      publisher: { "@id": `${site}/#organization` },
    },
    ...services.map((s) => ({
      "@type": "Service",
      name: s.name,
      provider: { "@id": `${site}/#organization` },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
      offers: { "@type": "Offer", price: priceOf(s.price), priceCurrency: "USD", url: `${site}${serviceHref(s)}` },
    })),
    {
      "@type": "FAQPage",
      mainEntity: homeFaqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} path="/" schema={homeSchema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <PhoneTestHome />
  </main>
  <SiteFooter />
</Base>
