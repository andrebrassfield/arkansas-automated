---
/*
 * /scores/nwa: NWA Online Front Door Scores, November 2026.
 * Data and method: src/data/online-score.ts. Scores only, no commentary on any
 * shop, no owner names, no recordings. Published on Dre's GO 2026-11-25.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PhoneTestForm from "../../components/PhoneTestForm.astro";
import { shops, checks, MAX_SCORE, CHECKED_ON } from "../../data/online-score";

const site = "https://arkansasautomated.com";
const path = "/scores/nwa";
const title = "NWA Home Service Online Scores, November 2026 | Arkansas Automated";
const description = `${shops.length} Northwest Arkansas HVAC, plumbing, roofing and electrical shops scored out of ${MAX_SCORE} on public checks: Google listing and website. Same checks for every shop, method published.`;
const groupMax = (g: string) => checks.filter((c) => c.group === g).reduce((n, c) => n + c.max, 0);
const sub = (s: (typeof shops)[number], g: string) => checks.filter((c) => c.group === g).reduce((n, c) => n + s.marks[c.key], 0);
const G = "Google listing";
const W = "Website as a crawler sees it";
const median = [...shops].map((s) => s.score).sort((a, b) => a - b)[Math.floor(shops.length / 2)];
const priced = shops.filter((s) => s.price).length;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      name: "NWA Home Service Online Front Door Scores, November 2026",
      description,
      url: `${site}${path}`,
      creator: { "@type": "Organization", name: "Arkansas Automated", url: site },
      temporalCoverage: "2026-11-25",
      spatialCoverage: "Northwest Arkansas",
      variableMeasured: checks.map((c) => c.label),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "NWA online scores", item: `${site}${path}` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={path} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>NWA online scores</nav>
        <span class="eyebrow">Checked {CHECKED_ON}</span>
        <h1 class="heading-xl measure">How {shops.length} NWA home service shops show up online, scored out of {MAX_SCORE}.</h1>
        <p class="body-lg measure" style="margin-top:1.2rem">
          HVAC, plumbing, roofing and electrical shops in Rogers, Springdale, Fayetteville and Bentonville. Same checks
          for every shop, all of them public: the Google listing, and the website as an AI assistant or search crawler
          reads it. The median score is {median}. {priced} of {shops.length} websites show any price at all.
        </p>
        <p class="measure" style="margin-top:1rem">
          This is not the Phone Test. Nobody was called, texted or sent a form. A shop can score well here and still let
          the phone ring out, which is what the free <a class="text-link" href="/phone-test">Phone Test</a> measures.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">The scores</h2>
        <div class="table-wrap" style="margin-top:1.2rem">
          <table class="compare-table score-table">
            <thead>
              <tr><th scope="col">#</th><th scope="col">Shop</th><th scope="col">Score</th><th scope="col">Google /{groupMax(G)}</th><th scope="col">Website /{groupMax(W)}</th><th scope="col">Trade</th><th scope="col">Town</th></tr>
            </thead>
            <tbody>
              {shops.map((s, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <th scope="row">{s.name}</th>
                  <td><strong>{s.score}</strong></td>
                  <td>{sub(s, G)}</td>
                  <td>{sub(s, W)}</td>
                  <td>{s.tradeLabel}</td>
                  <td>{s.townLabel}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine-print" style="margin-top:0.9rem">Ties are ordered by review count. Town is the Maps search the shop came from, not necessarily where it is based.</p>
      </div>
    </section>

    <section class="section">
      <div class="container article-body">
        <h2 class="heading-lg measure">How shops were picked</h2>
        <p>
          On {CHECKED_ON} we searched Google Maps for "hvac", "plumber", "roofing" and "electrician" in each of the four
          towns. From each search we took the top two results not marked Sponsored, skipping a shop already picked.
          Nobody was added by hand. Two shops were left out because Arkansas Automated has a business conversation open with them.
        </p>

        <h2 class="heading-lg measure">The checks</h2>
        {[G, W].map((g) => (
          <>
            <h3 class="heading-md">{g} ({groupMax(g)} points)</h3>
            <ul class="score-checks">
              {checks.filter((c) => c.group === g).map((c) => <li><strong>{c.label}</strong> <span>{c.max} pts</span><p>{c.how}</p></li>)}
            </ul>
          </>
        ))}

        <details class="score-detail">
          <summary>Every check for every shop</summary>
          <div class="table-wrap" style="margin-top:1rem">
            <table class="compare-table score-table">
              <thead><tr><th scope="col">Shop</th>{checks.map((c) => <th scope="col">{c.label}</th>)}</tr></thead>
              <tbody>
                {shops.map((s) => (
                  <tr><th scope="row">{s.name}</th>{checks.map((c) => <td>{s.marks[c.key]}/{c.max}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>

        <h2 class="heading-lg measure">Your shop on this list?</h2>
        <p>
          If something here is out of date, or you fixed it, email <a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a>
          and we will re-check it and update the score. We re-run every shop each month.
        </p>
        <p>
          Want the part this page cannot see? The free Phone Test calls your shop day and after hours, fills out your
          form and texts your number, then scores the whole front door out of 100 within 3 days.
        </p>
      </div>
    </section>

    <section class="section section-tint" id="start">
      <div class="container" style="max-width:640px">
        <PhoneTestForm formId="scores-nwa-form" placement="scores-nwa" heading="Get the full Phone Test for your shop" compact />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .score-table { min-width: 560px; }
  .score-table td, .score-table th { padding: 0.7rem 0.9rem; }
  .score-table tbody th { white-space: normal; min-width: 11rem; }
  .score-checks { list-style: none; padding: 0; margin: 1rem 0 1.6rem; border-top: 1px solid var(--line); }
  .score-checks li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  .score-checks span { color: var(--accent); font-weight: 800; font-size: 0.85rem; margin-left: 0.4rem; }
  .score-checks p { color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.2rem; }
  .score-detail summary { cursor: pointer; font-weight: 700; margin: 1.4rem 0 0.4rem; }
  .score-detail .compare-table { min-width: 1100px; font-size: 0.85rem; }
</style>
