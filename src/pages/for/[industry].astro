---
/*
 * /for/[industry] — Personas playbook (programmatic-seo skill). Trade-specific
 * leaks, automate-first items, and FAQs from src/data/industries.ts, with
 * Service + FAQPage + BreadcrumbList schema.
 *
 * GEO prompt-matching pass (teardown fix #4): the title keeps the indexed head
 * phrase "AI for {Trade} in Arkansas" verbatim as the prefix, then carries the
 * question an owner actually types into an assistant. The H1 is the same
 * question, and the `automate` section below it is the answer.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PhoneTestForm from "../../components/PhoneTestForm.astro";
import { industries, industryBySlug } from "../../data/industries";

export function getStaticPaths() {
  return industries.map((i) => ({ params: { industry: i.slug } }));
}

const { industry: slug } = Astro.params;
const ind = industryBySlug(slug);
const display = ind.name.charAt(0).toUpperCase() + ind.name.slice(1);
const seoName =
  ({ landscapers: "Landscapers", "medical-clinics": "Medical Clinics" } as Record<string, string>)[ind.slug] ?? display;

const title = `Free Phone Test for Arkansas ${seoName} | Arkansas Automated`;
const description = `How Arkansas ${ind.name.toLowerCase()} lose calls, quotes and reviews, and a free Phone Test that times your own shop. Score out of 100 within 3 days.`;

const sharedFaqs = [
  {
    q: "Where do I start?",
    a: "With the free Phone Test. We call your shop during the day and after hours, fill out your form, text your number and check your Google listing. You get a score out of 100 and your three biggest leaks with the clock times.",
  },
  {
    q: "Can you set it up and run it for me?",
    a: "Yes. The Front Door Setup starts at $1,500 one-time and Front Door Monthly starts at $497 a month with no contract. You only pay to fix what the Phone Test found.",
  },
];

const faqs = [...ind.faqs, ...sharedFaqs];
const otherTrades = industries.filter((i) => i.slug !== ind.slug).slice(0, 5);

const site = "https://arkansasautomated.com";
const pageUrl = `${site}/for/${ind.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: `AI automation for ${ind.name}`,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: ind.intent,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Industries", item: `${site}/for` },
        { "@type": "ListItem", position: 3, name: display, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} path={`/for/${ind.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/for">Industries</a><span>/</span>{display}
        </nav>
        <h1 class="heading-xl measure">What should {ind.name} in Arkansas automate first?</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{ind.angle}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="#contact" data-cta={`industry-${ind.slug}-hero`}>Get my free Phone Test</a>
          <a class="btn btn-secondary" href="/services">See prices</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg measure">Where a {ind.singular} loses the week.</h2>
        <div class="leak-grid">
          {
            ind.leaks.map((l) => (
              <article class="leak">
                <h3>{l.h}</h3>
                <p>{l.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-lg measure">What to automate first.</h2>
        <p class="body-lg measure" style="margin-top:1rem">
          In this order. Each one pays for the next, and none of them requires new staff.
        </p>
        <div class="rows">
          {
            ind.automate.map((a, idx) => (
              <article class="row">
                <div class="row-n">{String(idx + 1).padStart(2, "0")}</div>
                <h3>{a.h}</h3>
                <p>{a.p}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Fix it yourself, or hand it to us.</h2>
        </div>
        <div>
          <p class="body-lg">
            The free Phone Test times your own shop against the leaks on this page. Fix them yourself from the list,
            or we set it up from $1,500 one-time and keep it working from $497 a month, no contract.
          </p>
          <p class="body-lg" style="margin-top:1.1rem">
            <a class="text-link" href="/phone-test">How the Phone Test works</a>.
            {" "}<a class="text-link" href="/services">See prices</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container faq-wrap">
        <h2 class="heading-lg measure">Questions {ind.name} ask us.</h2>
        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-md">Other trades</h2>
        <div class="link-chips">
          {otherTrades.map((i) => (
            <a class="chip" href={`/for/${i.slug}`}>{i.name.charAt(0).toUpperCase() + i.name.slice(1)}</a>
          ))}
          <a class="chip chip-strong" href="/for">All industries</a>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container split">
        <div>
          <h2 class="heading-lg">Get the free Phone Test.</h2>
          <p class="body-lg" style="margin-top:1rem">
            Business name, your mobile, trade and town. We run the test over about three days and walk you
            through the score in 15 minutes. If your front door is already tight, we will tell you that too.
          </p>
          <p class="fine-print" style="margin-top:2rem">
            Last updated November 2026. Written by Andre Brassfield, founder of Arkansas Automated.
          </p>
        </div>
        <PhoneTestForm formId={`industry-${ind.slug}-form`} placement={`industry-${ind.slug}`} compact />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
