---
/*
 * /for — hub for the Personas cluster. Lists every industry page, links all
 * spokes, ItemList + BreadcrumbList schema.
 */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { industries } from "../../data/industries";

const title = "By Trade: Phone Test and Front Door Setup | Arkansas Automated";
const description =
  "How Arkansas plumbers, HVAC, electrical, roofing and landscaping shops lose calls, quotes and reviews, and the free Phone Test that times your own shop.";

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Industries served by Arkansas Automated",
      itemListElement: industries.map((ind, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: `AI for ${ind.name}`,
        url: `${site}/for/${ind.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Industries", item: `${site}/for` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/for" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Industries
        </nav>
        <h1 class="heading-xl measure">Built for how your trade actually runs.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          An HVAC freeze spike and a roofing storm week leak calls in different ways. Pick your trade
          for the leaks, what to fix first, and what it costs.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="city-grid">
          {
            industries.map((ind) => (
              <a class="city-card" href={`/for/${ind.slug}`}>
                <span class="prop-name">{ind.name.charAt(0).toUpperCase() + ind.name.slice(1)}</span>
                <span class="prop-role">{ind.intent}</span>
                <span class="city-cta">For {ind.name} ↗</span>
              </a>
            ))
          }
        </div>
        <p class="body-lg measure" style="margin-top:2.5rem;font-size:1rem">
          Your trade is not listed? The
          <a class="text-link" href="/phone-test">free Phone Test</a>
          works for any home service business.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
