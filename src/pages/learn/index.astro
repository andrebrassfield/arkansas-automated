---
/* /learn — hub for the guide cluster. */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Guides for Home Service Owners | Arkansas Automated";
const description =
  "Plain-language guides on missed calls, follow-up and automation, written for Arkansas home service owners, not engineers.";

const guides = [
  {
    slug: "missed-call-statistics-2026",
    name: "Missed call statistics (2026)",
    role: "Primary-sourced numbers on unanswered phones and what they cost a shop.",
  },
  {
    slug: "what-is-business-process-automation",
    name: "What is business process automation?",
    role: "The handoffs where small businesses leak, in the order to fix them.",
  },
];

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "AI and automation guides",
      itemListElement: guides.map((g, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: g.name,
        url: `${site}/learn/${g.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Learn", item: `${site}/learn` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/learn" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Learn
        </nav>
        <h1 class="heading-xl measure">Plain answers on AI and automation.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Short guides written for Arkansas business owners, not engineers. Real numbers,
          honest trade-offs, and no jargon. If you want the outcome without a class, start with
          the {" "}<a class="text-link" href="/phone-test">free Phone Test</a>.
        </p>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="city-grid">
          {
            guides.map((g) => (
              <a class="city-card" href={`/learn/${g.slug}`}>
                <span class="prop-name">{g.name}</span>
                <span class="prop-role">{g.role}</span>
                <span class="city-cta">Read the guide</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
