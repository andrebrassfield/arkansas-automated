---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PhoneTestForm from "../../components/PhoneTestForm.astro";
import { cities } from "../../data/cities";
import { rubric } from "../../data/phone-test";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../../lib/public-phone";

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const site = "https://arkansasautomated.com";
const isHome = c.slug === "fort-smith";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: `Phone Test and front door setup in ${c.name}, Arkansas`,
      description: `Free Phone Test for ${c.name} home service businesses: day and after-hours calls, web form, text and Google listing checks, then a setup that answers, follows up and gets reviews.`,
      provider: { "@type": "Organization", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "City", name: `${c.name}, Arkansas` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Locations", item: `${site}/locations` },
        { "@type": "ListItem", position: 3, name: c.name, item: `${site}/locations/${c.slug}` },
      ],
    },
  ],
};
const nearby = c.nearby.map((slug) => cities.find((city) => city.slug === slug)).filter(Boolean) as typeof cities;
const title = `Free Phone Test for ${c.name} Home Service Businesses | Arkansas Automated`;
const description = `We call your ${c.name} shop day and night, fill out your form, text your number and check your Google listing. Free score out of 100 within 3 days.`;
---

<Base title={title} description={description} path={`/locations/${c.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/locations">Locations</a><span>/</span>{c.name}</nav>
        <span class="eyebrow">{c.region} / {c.drive}</span>
        <h1 class="heading-xl measure">{isHome ? "Fort Smith shops: find out what your customers hear when they call." : `${c.name} shops: find out what your customers hear when they call.`}</h1>
        <p class="body-lg measure" style="margin-top:1.2rem">A free Phone Test for {c.name} home service businesses. We call during the day and after hours, fill out your web form, text your number, and check your Google listing against the shop at the top of the map for your trade in {c.name}. Score out of 100 within 3 days.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#start" data-cta={`city-${c.slug}-hero`}>Get my free Phone Test</a>
          <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF} data-cta={`city-${c.slug}-call`}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container split">
        <div><span class="eyebrow">Local context</span><h2 class="heading-lg">Work in {c.name} has its own rhythm.</h2><p class="body-lg">{c.economy}</p></div>
        <div class="flow">{c.angle.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <div>
          <span class="eyebrow">What we check for {c.name} shops</span>
          <h2 class="heading-lg">{isHome ? "Built in Fort Smith, tested on Fort Smith phones." : "Same test, your town's Map Pack."}</h2>
          <ul class="loc-rubric">{rubric.map((r) => <li><strong>{r.name}</strong> <span>{r.points} pts</span><p>{r.why}</p></li>)}</ul>
          <p><a class="text-link" href="/phone-test">See all checks ↗</a></p>
        </div>
        <div id="start"><PhoneTestForm formId={`city-${c.slug}-form`} placement={`city-${c.slug}`} heading={`Phone Test for your ${c.name} shop`} compact /></div>
      </div>
    </section>

    {nearby.length > 0 && (
      <section class="section section-tint">
        <div class="container">
          <h2 class="heading-md">Nearby</h2>
          <div class="city-grid">{nearby.map((n) => <a class="city-card" href={`/locations/${n.slug}`}><span class="prop-name">{n.name}</span><span class="city-cta">Phone Test in {n.name} ↗</span></a>)}</div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .loc-rubric { list-style: none; margin: 1.4rem 0; border-top: 1px solid var(--line); }
  .loc-rubric li { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .loc-rubric span { color: var(--accent); font-weight: 800; font-size: 0.85rem; margin-left: 0.4rem; }
  .loc-rubric p { color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.2rem; }
</style>
