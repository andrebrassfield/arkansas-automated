---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { regions, cities } from "../../data/cities";
const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "ItemList", name: "Arkansas areas served by Arkansas Automated", itemListElement: cities.map((c,i) => ({ "@type": "ListItem", position: i+1, name: `AI setups and automations in ${c.name}, Arkansas`, url: `${site}/locations/${c.slug}` })) },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${site}/` }, { "@type": "ListItem", position: 2, name: "Locations", item: `${site}/locations` }] }
  ]
};
const byRegion = regions.map((r) => ({ ...r, items: r.slugs.map((slug) => cities.find((c) => c.slug === slug)!) }));
---
<Base title="AI Setups & Automation Across Arkansas | Arkansas Automated" description="AI answering, lead follow-up and business automation setups for Arkansas companies. Based in Fort Smith, serving the River Valley, Northwest Arkansas, and beyond." path="/locations" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero"><div class="container"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Locations</nav><span class="eyebrow">Fort Smith based / Arkansas serving</span><h1 class="heading-xl measure">AI setups where you do business.</h1><p class="body-lg measure" style="margin-top:1rem">We build answering, follow-up, and connected workflows around the way your business actually operates. Find your city below, or <a class="text-link" href="/services">explore the setups and pricing</a>.</p><div class="hero-ctas"><a class="btn btn-primary" href="https://book.arkansasautomated.com/book/discovery-call">Talk through your setup</a></div></div></section>
    {byRegion.map((r,i) => <section class:list={["section",i%2===0&&"section-tint"]}><div class="container"><h2 class="heading-lg">{r.name}</h2><div class="city-grid">{r.items.map((c) => <a class="city-card" href={`/locations/${c.slug}`}><span class="prop-name">{c.name}</span><span class="prop-role">{c.drive}</span><span class="city-cta">AI setups in {c.name} ↗</span></a>)}</div></div></section>)}
  </main><SiteFooter />
</Base>
