---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { regions, cities } from "../../data/cities";
const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "ItemList", name: "Arkansas areas served by Arkansas Automated", itemListElement: cities.map((c,i) => ({ "@type": "ListItem", position: i+1, name: `Phone Test in ${c.name}, Arkansas`, url: `${site}/locations/${c.slug}` })) },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${site}/` }, { "@type": "ListItem", position: 2, name: "Locations", item: `${site}/locations` }] }
  ]
};
const byRegion = regions.map((r) => ({ ...r, items: r.slugs.map((slug) => cities.find((c) => c.slug === slug)!) }));
---
<Base title="Where We Work: River Valley and NWA | Arkansas Automated" description="Free Phone Test and front door setups for home service businesses in Fort Smith, Van Buren, Russellville and Northwest Arkansas. Set up in person." path="/locations" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero"><div class="container"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Locations</nav><span class="eyebrow">Fort Smith based / set up in person</span><h1 class="heading-xl measure">River Valley and Northwest Arkansas.</h1><p class="body-lg measure" style="margin-top:1rem">We set up in person, so we stay close to home. Pick your town for local context and the free Phone Test, or <a class="text-link" href="/services">see prices</a>.</p><div class="hero-ctas"><a class="btn btn-primary" href="/phone-test" data-cta="locations-hero">Get my free Phone Test</a></div></div></section>
    {byRegion.map((r,i) => <section class:list={["section",i%2===0&&"section-tint"]}><div class="container"><h2 class="heading-lg">{r.name}</h2><div class="city-grid">{r.items.map((c) => <a class="city-card" href={`/locations/${c.slug}`}><span class="prop-name">{c.name}</span><span class="prop-role">{c.drive}</span><span class="city-cta">Phone Test in {c.name} ↗</span></a>)}</div></div></section>)}
  </main><SiteFooter />
</Base>
