---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
import LeadForm from "../components/LeadForm.astro";
const title = "Contact Arkansas Automated | Fort Smith";
const description = `Call ${AA_PUBLIC_PHONE_DISPLAY} or email dre@arkansasautomated.com. Arkansas Automated serves the River Valley and Northwest Arkansas from Fort Smith.`;
---
<Base title={title} description={description} path="/contact">
  <SiteNav />
  <main id="main-content" tabindex="-1"><section class="section"><div class="container article-body">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></nav>
    <h1 class="heading-lg">Talk with Arkansas Automated.</h1>
    <p class="body-lg">The fastest start is the free Phone Test. Business name, mobile, trade and town, and we take it from there.</p>
    <div class="link-chips"><a class="chip chip-strong" href="/phone-test" data-cta="contact-phone-test">Free Phone Test</a><a class="chip" href="/services">Prices</a></div>
    <h2 class="heading-md">Call</h2>
    <p><a class="text-link" href={AA_PUBLIC_PHONE_HREF}>{AA_PUBLIC_PHONE_DISPLAY}</a></p>
    <h2 class="heading-md">Service area</h2>
    <p>The River Valley and Northwest Arkansas, set up in person. <a class="text-link" href="/locations/fort-smith">Fort Smith</a>. <a class="text-link" href="/locations/rogers">Rogers</a>. <a class="text-link" href="/locations">All locations</a>.</p>
    <h2 class="heading-md">Email</h2>
    <p><a class="text-link" href="mailto:dre@arkansasautomated.com">dre@arkansasautomated.com</a></p>
    <p class="fine-print">We usually reply within one business day.</p>

    <h2 class="heading-md" id="send-details">Send the details</h2>
    <p>If you would rather write than call, send the basics here. One business name, one name, one email, and a line about what breaks. We reply within one business day.</p>
    <div style="max-width:34rem;margin-top:1.25rem">
      <LeadForm
        formId="contact-lead"
        defaultIntent="Contact page question"
        detailsPlaceholder="Example: calls go to voicemail after 5, estimates never get followed up, booking is all by text."
        submitLabel="Send my request"
      />
    </div>
  </div></section></main>
  <SiteFooter />
</Base>
