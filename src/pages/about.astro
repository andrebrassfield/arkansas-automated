---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "About Arkansas Automated | Rogers and Fort Smith";
const description = "Andre Brassfield founded Arkansas Automated. We serve Rogers and Fort Smith. Brassfield Ventures LLC. Not affiliated with Arkansas Automated Security.";
---

<Base title={title} description={description} path="/about">
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="section">
      <div class="container article-body">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>About</span></nav>
        <h1 class="heading-lg">Automation built by Arkansas operators.</h1>
        <p class="body-lg">Arkansas Automated is an AI and business automation company serving Rogers and Fort Smith. Andre Brassfield founded it. The company is Brassfield Ventures LLC, based in Fort Smith.</p>
        <p>We set up AI answering, lead follow-up, booking, and connected workflows for businesses that want less manual work. Explore <a class="text-link" href="/services">services and pricing</a>, or find your city on the <a class="text-link" href="/locations">locations page</a>.</p>
        <h2 class="heading-md">Built for you, with clear handoffs</h2>
        <p>We assess your process, scope the setup, test the exceptions, and put the right human in the loop. You get a working system and a clear owner for the parts that should never run unattended.</p>
        <h2 class="heading-md">We operate what we recommend</h2>
        <p>Our related properties include <a class="text-link" href="https://fortsmithdirectory.com">Fort Smith Directory</a>, <a class="text-link" href="https://nwaautomated.com">NWA Automated</a>, <a class="text-link" href="https://smarthomenwa.com">Smart Home NWA</a>, and <a class="text-link" href="https://goodgarageco.com">Good Garage Co.</a>. These businesses give us first-hand experience with local intake, routing, follow-up, and field-service operations.</p>
        <h2 class="heading-md">Where automation stops</h2>
        <p>Judgment, negotiation, pricing exceptions, and trust-building conversations stay with people. Read our <a class="text-link" href="/automation-guardrails">automation guardrails</a> for the operating principles we use.</p>
        <h2 class="heading-md">About the name</h2>
        <p>Arkansas Automated is operated by Brassfield Ventures LLC, based in Fort Smith, Arkansas. We are an AI and automation services company. We are not affiliated with Arkansas Automated Security, LLC of Mayflower, Arkansas, which is a separate security and alarm installation business.</p>
        <div class="next-step"><a class="btn btn-primary" href="/audit">Book the audit</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
