---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Speed to Lead — How Fast Response Times Win More Jobs | Arkansas Automated";
const description =
  "Measure how quickly your business responds to new leads. Most contractors lose jobs to slower competitors. Free lead response audit.";
---

<Base {title} {description}>
  <SiteNav />

  <main>
    {/* Hero */}
    <section class="relative overflow-hidden bg-gradient-to-b from-[#0f172a] to-[#1e293b] px-6 py-24 text-center text-white sm:py-32">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(59,130,246,0.15),transparent_70%)]" />
      <div class="relative mx-auto max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue-400">Free lead response audit</p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Speed to Lead
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300 sm:text-xl">
          Most local businesses lose jobs before they even know a lead came in.
          We measure your response time, grade it against your competitors,
          and show you exactly what slow response costs.
        </p>
        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href="https://speed-to-lead-five.vercel.app"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-blue-600 px-8 text-base font-semibold text-white transition-colors hover:bg-blue-500"
          >
            Get your free audit
          </a>
          <a
            href="#how-it-works"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full border border-slate-600 px-8 text-base font-semibold text-slate-300 transition-colors hover:border-slate-400 hover:text-white"
          >
            See how it works
          </a>
        </div>
      </div>
    </section>

    {/* The Problem */}
    <section class="bg-white px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          The first contractor to respond wins
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          A homeowner calls three roofers. One answers. Two go to voicemail.
          The one who answered books the job. The other two never know they lost it.
        </p>
        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <div class="text-3xl font-bold text-blue-600">5 min</div>
            <p class="mt-2 text-sm text-slate-600">
              The average response time for local service businesses.
              By then, the homeowner has already called two more.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <div class="text-3xl font-bold text-blue-600">78%</div>
            <p class="mt-2 text-sm text-slate-600">
              Of customers go with the first responder.
              Speed isn't a nice-to-have — it's the deciding factor.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <div class="text-3xl font-bold text-red-500">$918K</div>
            <p class="mt-2 text-sm text-slate-600">
              Annual revenue lost by a typical plumbing company
              to slow or missed lead response. That's real money walking out the door.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* What We Measure */}
    <section id="how-it-works" class="bg-slate-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          What the audit measures
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          We submit a real lead through your website and measure every step
          of your response pipeline.
        </p>
        <div class="mt-12 space-y-8">
          {[
            {
              step: "1",
              title: "Lead submission",
              desc: "We submit a realistic service request through your web form — same kind of lead a real customer would send.",
            },
            {
              step: "2",
              title: "Response detection",
              desc: "We monitor your inbox for a reply. Automated or human, we catch it and timestamp it.",
            },
            {
              step: "3",
              title: "Grading",
              desc: "Your response time gets graded A through F against industry benchmarks. A = under 5 minutes. F = never responded.",
            },
            {
              step: "4",
              title: "Revenue impact",
              desc: "We calculate what slow response costs you annually, based on your average job value and close rate.",
            },
          ].map((item) => (
            <div class="flex gap-6">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">
                {item.step}
              </div>
              <div>
                <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
                <p class="mt-1 text-slate-600">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="bg-[#0f172a] px-6 py-20 text-center sm:py-24">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Find out what slow response is costing you
        </h2>
        <p class="mt-4 text-lg text-slate-400">
          Free, no-obligation audit. Takes two minutes. You get a full report
          with your grade, revenue impact, and benchmarks.
        </p>
        <div class="mt-10">
          <a
            href="https://speed-to-lead-five.vercel.app"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-blue-600 px-8 text-base font-semibold text-white transition-colors hover:bg-blue-500"
          >
            Run your free audit
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
