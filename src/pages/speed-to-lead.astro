---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Speed to Lead — How Fast Response Times Win More Jobs | Arkansas Automated";
const description =
  "Measure how quickly your business responds to new leads. Most contractors lose jobs to slower competitors. Free lead response audit.";

const stats = [
  { n: "5 min", h: "Average response time", p: "The average response time for local service businesses. By then, the homeowner has already called two more." },
  { n: "78%", h: "First-responder wins", p: "Of customers go with the first responder. Speed isn't a nice-to-have — it's the deciding factor." },
  { n: "$918K", h: "Revenue left on the table", p: "Annual revenue lost by a typical plumbing company to slow or missed lead response." },
];

const steps = [
  { n: "1", h: "Lead submission", p: "We submit a realistic service request through your web form — same kind of lead a real customer would send." },
  { n: "2", h: "Response detection", p: "We monitor your inbox for a reply. Automated or human, we catch it and timestamp it." },
  { n: "3", h: "Grading", p: "Your response time gets graded A through F against industry benchmarks. A = under 5 minutes. F = never responded." },
  { n: "4", h: "Revenue impact", p: "We calculate what slow response costs you annually, based on your average job value and close rate." },
];
---

<Base {title} {description} path="/speed-to-lead">
  <SiteNav />

  <main>
    {/* Hero */}
    <section class="hero">
      <div class="container">
        <p class="accent" style="font-size:0.85rem; letter-spacing:0.14em; text-transform:uppercase; margin-bottom:1rem;">Free lead response audit</p>
        <h1 class="heading-xl">Speed to Lead</h1>
        <p class="body-lg" style="margin-top:1rem; max-width:42rem;">
          Most local businesses lose jobs before they even know a lead came in.
          We measure your response time, grade it against your competitors,
          and show you exactly what slow response costs.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="https://speed-to-lead-five.vercel.app">Get your free audit</a>
          <a class="btn btn-secondary" href="#how-it-works">See how it works</a>
        </div>
      </div>
    </section>

    {/* The Problem */}
    <section class="section section-tint">
      <div class="container">
        <h2 class="heading-lg">The first contractor to respond wins</h2>
        <p class="body-lg" style="margin-top:1rem; max-width:42rem;">
          A homeowner calls three roofers. One answers. Two go to voicemail.
          The one who answered books the job. The other two never know they lost it.
        </p>
        <div class="leak-grid" style="margin-top:3rem;">
          {stats.map((s) => (
            <article class="leak">
              <h3 class="heading-md accent" style="margin-bottom:0.5rem;">{s.n}</h3>
              <p style="font-weight:600; margin-bottom:0.5rem;">{s.h}</p>
              <p>{s.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* What We Measure */}
    <section id="how-it-works" class="section">
      <div class="container">
        <h2 class="heading-lg">What the audit measures</h2>
        <p class="body-lg" style="margin-top:1rem; max-width:42rem;">
          We submit a real lead through your website and measure every step
          of your response pipeline.
        </p>
        <div class="rows">
          {steps.map((s) => (
            <div class="row" style="grid-template-columns: 2.5rem 1fr;">
              <span class="row-n">{s.n}</span>
              <div>
                <h3>{s.h}</h3>
                <p>{s.p}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="section section-tint">
      <div class="container" style="text-align:center; max-width:42rem; margin:0 auto;">
        <h2 class="heading-lg">Find out what slow response is costing you</h2>
        <p class="body-lg" style="margin-top:1rem;">
          Free, no-obligation audit. Takes two minutes. You get a full report
          with your grade, revenue impact, and benchmarks.
        </p>
        <div style="margin-top:2.5rem;">
          <a class="btn btn-primary" href="https://speed-to-lead-five.vercel.app">Run your free audit</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
