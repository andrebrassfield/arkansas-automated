---
/* /services/[service]: one page per offer on the ladder. */
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PhoneTestForm from "../../components/PhoneTestForm.astro";
import { services, serviceBySlug, serviceHref } from "../../data/services";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../../lib/public-phone";

export function getStaticPaths() {
  return services.filter((s) => s.slug !== "phone-test").map((s) => ({ params: { service: s.slug } }));
}

const { service: slug } = Astro.params;
const s = serviceBySlug(slug as string);

const title = `${s.name} for Arkansas Home Service Businesses | Arkansas Automated`;
const description = `${s.tagline} ${s.price}.`.slice(0, 300);
const site = "https://arkansasautomated.com";
const pageUrl = `${site}/services/${s.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: s.name,
      provider: { "@type": "ProfessionalService", name: "Arkansas Automated", url: site },
      areaServed: { "@type": "State", name: "Arkansas" },
      description: s.answer,
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${site}/services` },
        { "@type": "ListItem", position: 3, name: s.name, item: pageUrl },
      ],
    },
  ],
};
const others = services.filter((x) => x.slug !== s.slug);
const showForm = s.cta.href === "/phone-test";
---

<Base title={title} description={description} path={`/services/${s.slug}`} schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{s.name}
        </nav>
        <span class="eyebrow">{s.rung > 0 ? `Step ${s.rung} · ` : "Add-on · "}{s.price}</span>
        <h1 class="heading-xl measure">{s.name}.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">{s.answer}</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href={showForm ? "#start" : s.cta.href} data-cta={`service-${s.slug}-hero`}>{s.cta.label}</a>
          <a class="btn btn-secondary" href={AA_PUBLIC_PHONE_HREF} data-cta={`service-${s.slug}-call`}>Call {AA_PUBLIC_PHONE_DISPLAY}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container svc-grid">
        <div>
          <h2 class="heading-md">What's included</h2>
          <ul class="svc-list">{s.includes.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h2 class="heading-md">How it works</h2>
          <ol class="svc-steps">{s.process.map((p) => <li><strong>{p.h}.</strong> {p.p}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container svc-grid">
        <div>
          <h2 class="heading-md">Questions</h2>
          {s.faqs.map((f) => <details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
        <div id="start">
          {showForm ? (
            <PhoneTestForm formId={`service-${s.slug}-form`} placement={`service-${s.slug}`} heading="Start with the free Phone Test" compact />
          ) : (
            <div class="svc-cta-card">
              <h2 class="heading-md">{s.cta.label}</h2>
              <a class="btn btn-primary" href={s.cta.href}>{s.cta.label}</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="heading-md">The rest of the ladder</h2>
        <div class="svc-others">
          {others.map((o) => <a href={serviceHref(o)}><span>{o.name}</span><strong>{o.price}</strong></a>)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .svc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .svc-list { list-style: none; margin-top: 1rem; border-top: 1px solid var(--line); }
  .svc-list li { padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .svc-steps { padding-left: 1.2rem; display: grid; gap: 0.8rem; margin-top: 1rem; color: var(--text-secondary); }
  .svc-steps strong { color: var(--text-primary); }
  .svc-cta-card { background: var(--bg-secondary); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 2rem; display: grid; gap: 1rem; }
  .svc-others { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 2rem; margin-top: 1rem; }
  .svc-others a { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .svc-others strong { color: var(--accent); white-space: nowrap; }
  @media (max-width: 860px) { .svc-grid, .svc-others { grid-template-columns: 1fr; } }
</style>
