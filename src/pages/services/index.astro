---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Prices | Arkansas Automated";
const description =
  "Flat monthly answering plans for Arkansas contractors: Missed-Call Text Back $129/mo, After-Hours Answering $299/mo, Front Desk $499/mo. Free missed-call test, first 7 days of service free, no per-minute charges, no contract.";

const ladder = [
  {
    name: "Missed-call test",
    price: "Free",
    p: "We call the line after the office is closed and send a short recording of what a customer hears. Proof before money.",
    href: "/missed-call-test",
  },
  {
    name: "Missed-Call Text Back",
    price: "$129/mo",
    p: "Every missed call gets a text back in under a minute, in your shop's name, with the job details captured and sent to you.",
    href: "/services/missed-call-text-back",
  },
  {
    name: "After-Hours Answering",
    price: "$299/mo",
    p: "Your phone answered 5 PM to 7 AM and all weekend. Emergencies straight to the on-call tech. $199 one-time setup, first 7 days free.",
    href: "/services/after-hours-answering",
  },
  {
    name: "Front Desk",
    price: "$499/mo",
    p: "24/7 answering, jobs booked into your calendar or software, estimate follow-up, and review requests. The full front office.",
    href: "/services/ai-front-desk",
  },
  {
    name: "Dead Estimate Revival",
    price: "$750 + 15%",
    p: "Your open estimates from the last 90 days, worked until they book. The 15% is on recovered gross only; it books nothing, it costs nothing.",
    href: "/services/estimate-revival",
  },
  {
    name: "Front Desk Audit",
    price: "$750",
    p: "Ninety minutes and a written map: every leak in calls, quotes, and follow-up, costed and ranked. The full fee credits toward any plan or build.",
    href: "/audit",
  },
  {
    name: "Custom builds",
    price: "From $2,500",
    p: "A scoped build when the fix is not a plan on this page. Priced in writing before work begins.",
    href: "/services/workflow-automation",
  },
  {
    name: "Advisor retainer",
    price: "From $2,000/mo",
    p: "For operations with 10 or more people. The map stays current and the next fix ships every month.",
    href: "/forward-deployed-ai-engineer",
  },
];

const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Arkansas Automated prices",
      itemListElement: ladder.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${s.name}, ${s.price}`,
        url: `${site}${s.href}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Prices", item: `${site}/services` },
      ],
    },
  ],
};
---

<Base title={title} description={description} path="/services" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>Prices
        </nav>
        <h1 class="heading-xl measure">The prices are on the page.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">
          Flat monthly plans, no per-minute meter, no contract. Start with the free missed-call test,
          run any answering plan free for its first 7 days on your real line, and pay only if it earns its keep.
        </p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href="/missed-call-test">Get the missed-call test</a>
          <a class="btn btn-secondary" href="/audit">See the $750 audit</a>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <div class="rows">
          {ladder.map((s) => (
            <article class="row row-pkg">
              <div class="row-n row-price">{s.price}</div>
              <h3><a class="text-link-plain" href={s.href}>{s.name}</a></h3>
              <p>{s.p}</p>
            </article>
          ))}
        </div>
        <p class="body-lg measure" style="margin-top:2.25rem;font-size:1rem">
          Machine-readable pricing for AI agents lives at
          {" "}<a class="text-link" href="/pricing.md">/pricing.md</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
