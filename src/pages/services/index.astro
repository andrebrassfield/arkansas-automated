---
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { services, PHONE_TEST_PATH, serviceHref } from "../../data/services";

const title = "Services and Prices | Arkansas Automated";
const description =
  "Free Phone Test, Front Door Setup from $1,500, Front Door Monthly from $497/mo, Ads at $3,000/mo flat and Dead Estimate Revival. Prices on the page for Arkansas home service businesses.";

const ladder = services.filter((s) => s.rung > 0).sort((a, b) => a.rung - b.rung);
const addOns = services.filter((s) => s.rung === 0);
const site = "https://arkansasautomated.com";
const schema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Arkansas Automated services",
  url: `${site}/services`,
  itemListElement: services.map((s) => ({
    "@type": "Offer",
    name: s.name,
    description: s.answer,
    url: `${site}${serviceHref(s)}`,
  })),
};
---

<Base title={title} description={description} path="/services" schema={schema}>
  <SiteNav />
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container">
        <span class="eyebrow">Services and prices</span>
        <h1 class="heading-xl measure">Four steps. Take only the next one.</h1>
        <p class="body-lg measure" style="margin-top:1.15rem">Every engagement starts with the free Phone Test, so you only pay to fix what the test found. Prices are on the page. The monthly plan has no contract.</p>
        <div class="hero-ctas" style="margin-top:2rem">
          <a class="btn btn-primary" href={PHONE_TEST_PATH} data-cta="services-hero">Get my free Phone Test</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container sv-ladder">
        {ladder.map((s) => (
          <article class="sv-rung">
            <div class="sv-rung-head">
              <span class="sv-step">STEP {s.rung}</span>
              <strong class="sv-price">{s.price}</strong>
            </div>
            <h2><a href={serviceHref(s)}>{s.name}</a></h2>
            <p class="sv-tag">{s.tagline}</p>
            <ul>{s.includes.slice(0, 5).map((i) => <li>{i}</li>)}</ul>
            <a class="text-link" href={serviceHref(s)}>Full details ↗</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section section-tint">
      <div class="container">
        <span class="eyebrow">Add-on</span>
        {addOns.map((s) => (
          <article class="sv-addon">
            <h2 class="heading-md"><a href={serviceHref(s)}>{s.name}</a> <span class="sv-price">{s.price}</span></h2>
            <p class="body-lg measure">{s.tagline}</p>
          </article>
        ))}
        <p class="fine-print" style="margin-top:2rem">We no longer sell answering plans, booking software or custom builds. Existing customers keep their current plans.</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .sv-ladder { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .sv-rung { background: var(--bg-secondary); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 2rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .sv-rung:first-child { background: var(--ink); color: var(--ink-on); border-color: var(--ink); }
  .sv-rung:first-child .sv-tag, .sv-rung:first-child li { color: rgba(246, 241, 231, 0.85); }
  .sv-rung:first-child .sv-price, .sv-rung:first-child .sv-step { color: var(--signal); }
  .sv-rung-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .sv-step { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; color: var(--accent); }
  .sv-price { color: var(--accent); font-weight: 800; }
  .sv-rung h2 { font-size: 1.7rem; }
  .sv-rung h2 a:hover { text-decoration: underline; }
  .sv-tag { color: var(--text-secondary); }
  .sv-rung ul { list-style: none; border-top: 1px solid var(--line); }
  .sv-rung:first-child ul { border-color: rgba(246, 241, 231, 0.18); }
  .sv-rung li { padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.93rem; color: var(--text-secondary); }
  .sv-rung:first-child li { border-color: rgba(246, 241, 231, 0.18); }
  .sv-rung .text-link { margin-top: auto; }
  .sv-addon { margin-top: 1rem; }
  .sv-addon .sv-price { font-size: 1rem; margin-left: 0.6rem; }
  @media (max-width: 800px) { .sv-ladder { grid-template-columns: 1fr; } }
</style>
