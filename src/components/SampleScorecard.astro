---
/*
 * Sample Phone Test scorecard for the hero. Every value is invented to show
 * the format and is labeled as a sample on the card. Never present it as a
 * real shop's result.
 */
const rows = [
  { test: "Daytime call", when: "Tue 10:42 am", result: "Voicemail. Callback 3 hr 12 min later", pts: "2/8", bad: true },
  { test: "After-hours call", when: "Tue 6:10 pm", result: "Voicemail. No text back", pts: "0/7", bad: true },
  { test: "Web form", when: "Tue 4:55 pm", result: "First reply Wed 9:31 am", pts: "2/8", bad: true },
  { test: "Asked for a price", when: "On the day call", result: "\"Someone will call you\"", pts: "2/7", bad: true },
  { test: "Map Pack", when: "\"roofer fort smith\"", result: "#6. Top shop has 4x the reviews", pts: "4/8", bad: false },
];
---

<aside class="sc" aria-label="Sample Phone Test scorecard. Not a real business.">
  <div class="sc-head">
    <p class="sc-label">SAMPLE PHONE TEST</p>
    <p class="sc-biz">Sample Roofing Co. <span>Fort Smith</span></p>
  </div>
  <ol class="sc-rows">
    {rows.map((r) => (
      <li class:list={["sc-row", r.bad && "is-bad"]}>
        <span class="sc-test">{r.test}<small>{r.when}</small></span>
        <span class="sc-result">{r.result}</span>
        <b class="sc-pts">{r.pts}</b>
      </li>
    ))}
  </ol>
  <div class="sc-total">
    <span>Total, all 21 checks</span>
    <strong>41<small>/100</small></strong>
  </div>
  <p class="sc-note">Sample scorecard with made-up numbers, showing 5 of 21 checks. Yours uses your real times.</p>
</aside>

<style>
  .sc { position: relative; background: var(--ink); color: var(--ink-on); border-radius: var(--radius-lg); padding: clamp(1.4rem, 2.6vw, 2.4rem); box-shadow: 0 24px 55px rgba(27, 27, 31, 0.2); }
  .sc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.2rem; }
  .sc-label { font-size: 0.72rem; letter-spacing: 0.16em; color: var(--signal); font-weight: 800; }
  .sc-biz { font-weight: 600; font-size: 0.95rem; text-align: right; }
  .sc-biz span { display: block; font-weight: 400; font-size: 0.8rem; color: rgba(246, 241, 231, 0.68); }
  .sc-rows { list-style: none; }
  .sc-row { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 0.9rem; align-items: baseline; padding: 0.85rem 0; border-top: 1px solid rgba(246, 241, 231, 0.14); line-height: 1.3; }
  .sc-test { font-weight: 600; font-size: 0.92rem; }
  .sc-test small { display: block; font-weight: 400; font-size: 0.75rem; color: rgba(246, 241, 231, 0.62); margin-top: 0.15rem; }
  .sc-result { font-size: 0.9rem; color: rgba(246, 241, 231, 0.88); }
  .sc-pts { font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  .sc-row.is-bad .sc-pts { color: var(--signal); }
  .sc-total { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(246, 241, 231, 0.3); padding-top: 1rem; margin-top: 0.2rem; }
  .sc-total span { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(246, 241, 231, 0.7); font-weight: 700; }
  .sc-total strong { font-family: var(--font-heading); font-size: 2.6rem; line-height: 1; color: var(--signal); }
  .sc-total strong small { font-size: 1rem; color: rgba(246, 241, 231, 0.7); margin-left: 0.15rem; }
  .sc-note { font-size: 0.74rem; color: rgba(246, 241, 231, 0.62); margin-top: 0.9rem; }
  @media (max-width: 600px) {
    .sc-row { grid-template-columns: 1fr auto; }
    .sc-result { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
