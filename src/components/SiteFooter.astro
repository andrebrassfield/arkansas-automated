---
/*
 * Shared site footer. Keeps every hub one click from every page (no orphans).
 * Reset 2026-11-16: the sister-site "Network" column is gone; it confused who
 * Arkansas Automated is.
 */
import BrandLockup from "./BrandLockup.astro";
import { industries } from "../data/industries";
import { cities } from "../data/cities";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
import { SITE_DESCRIPTOR } from "../lib/seo";

const footerCities = cities.filter((c) => ["fort-smith", "van-buren", "fayetteville", "rogers", "bentonville"].includes(c.slug));
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid footer-grid-wide">
      <div>
        <div class="brand"><BrandLockup /></div>
        <p class="body-lg" style="margin-top:0.9rem;max-width:34ch;font-size:1rem">{SITE_DESCRIPTOR}</p>
        <p class="footer-phone"><a href={AA_PUBLIC_PHONE_HREF}>{AA_PUBLIC_PHONE_DISPLAY}</a></p>
      </div>
      <nav class="footer-col" aria-label="Start">
        <h2>Start</h2>
        <a href="/phone-test">Free Phone Test</a>
        <a href="/services">Services and prices</a>
        <a href="/missed-call-cost-calculator">Missed-call calculator</a>
        <a href="/answer-check">AI answer check</a>
        <a href="/fix">Leaks we fix</a>
      </nav>
      <nav class="footer-col" aria-label="Trades">
        <h2>Trades</h2>
        {industries.map((i) => <a href={`/for/${i.slug}`}>{i.name.charAt(0).toUpperCase() + i.name.slice(1)}</a>)}
        <a href="/for">All trades</a>
      </nav>
      <nav class="footer-col" aria-label="Where">
        <h2>Where</h2>
        {footerCities.map((c) => <a href={`/locations/${c.slug}`}>{c.name}</a>)}
        <a href="/locations">All locations</a>
        <a href="/ai-consulting/northwest-arkansas">AI consulting, NWA</a>
        <a href="/ai-consulting/river-valley">AI consulting, Fort Smith</a>
      </nav>
      <nav class="footer-col" aria-label="Company">
        <h2>Company</h2>
        <a href="/about">About</a>
        <a href="/marketing">Ads</a>
        <a href="/learn">Guides</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Arkansas Automated. Built and operated in Fort Smith, Arkansas.</p>
      <nav class="footer-legal" aria-label="Legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/automation-guardrails">Automation guardrails</a></nav>
    </div>
  </div>
</footer>
