---
/*
 * Homepage, reset 2026-11-16. One promise (proof before pitch), one
 * conversion (the free Phone Test), one ladder of offers with prices.
 * Copy rules: plain, operator voice, no em or en dashes, every claim either
 * true today or sourced on the page.
 */
import BrandLockup from "./BrandLockup.astro";
import SampleScorecard from "./SampleScorecard.astro";
import PhoneTestForm from "./PhoneTestForm.astro";
import { services, BOOK_CALL_URL, serviceHref } from "../data/services";
import { rubric, RUBRIC_CHECK_COUNT, ASK_FOR_ME_SOURCE } from "../data/phone-test";
import { AA_PUBLIC_PHONE_DISPLAY, AA_PUBLIC_PHONE_HREF } from "../lib/public-phone";
import { SITE_TAGLINE } from "../lib/seo";

const ladder = services.filter((s) => s.rung > 0).sort((a, b) => a.rung - b.rung);
const addOn = services.find((s) => s.rung === 0);

export const homeFaqs = [
  {
    q: "What does Arkansas Automated do?",
    a: "Arkansas Automated tests and fixes how Arkansas home service businesses answer, follow up and get reviewed. It starts with a free Phone Test of your shop, then a one-time setup and an optional monthly plan that keeps it working.",
  },
  {
    q: "Is the Phone Test really free?",
    a: "Yes. No card, no contract and no logins. You get a score out of 100, your three biggest leaks with the clock times, and what each one costs at your numbers. It is yours whether you hire us or not.",
  },
  {
    q: "Do you sell an AI receptionist?",
    a: "No. We set things up so your own phones ring the right people first, and every missed call or form gets a fast text and a follow-up. If you want an AI answering your phone, we will tell you what to look for, but we do not run one.",
  },
  {
    q: "Why does Google's AI matter for my shop?",
    a: "Google's AI now calls local contractors to ask about prices and availability, then sends the homeowner a summary. It only calls shops that show up in local search, and a shop that will not give a price range drops out of the comparison. The Phone Test checks both.",
  },
  {
    q: "What does it cost to fix?",
    a: "The Front Door Setup starts at $1,500 one-time. Front Door Monthly starts at $497 a month with no contract. Ads management is a flat $3,000 a month and only for shops that score 80 or higher on the Phone Test.",
  },
  {
    q: "Do I have to switch software?",
    a: "No. We start with the phone, calendar and job software you already pay for and only add a tool when yours cannot do the job.",
  },
];
---

<section class="ph-hero" aria-labelledby="home-title">
  <div class="ph-hero-mark" aria-hidden="true"><BrandLockup variant="mark" /></div>
  <div class="container ph-hero-grid">
    <div>
      <p class="ph-kicker"><i class="dia" aria-hidden="true"></i>RIVER VALLEY AND NWA HOME SERVICE BUSINESSES</p>
      <h1 id="home-title">We call your shop <em>before we ever pitch you.</em></h1>
      <p class="ph-lede">A free Phone Test. We call during the day and after hours, fill out your web form, text your number, and check your Google listing against the shop at the top of the map. You get the clock times and a score out of 100 within 3 days.</p>
      <div class="ph-actions">
        <a class="btn btn-primary" href="#get-the-test" data-cta="hero-phone-test">Get my free Phone Test</a>
        <a class="btn btn-secondary" href="/phone-test" data-cta="hero-what-we-test">See what we test</a>
      </div>
      <p class="ph-under">No logins needed. Dre Brassfield, Fort Smith. <a href={AA_PUBLIC_PHONE_HREF} data-cta="hero-call">{AA_PUBLIC_PHONE_DISPLAY}</a></p>
    </div>
    <SampleScorecard />
  </div>
</section>

<section class="ph-strip" aria-label="What we fix">
  <div class="container ph-strip-inner">
    {SITE_TAGLINE.split(". ").map((w) => <span><i class="dia" aria-hidden="true"></i>{w.replace(/\.$/, "").toUpperCase()}</span>)}
  </div>
</section>

<section class="section" aria-labelledby="why-now">
  <div class="container ph-split">
    <div>
      <p class="ph-kicker">WHY NOW</p>
      <h2 id="why-now" class="heading-lg">Google's AI is calling contractors for prices.</h2>
    </div>
    <div>
      <p class="body-lg">Google's AI now calls local contractors to ask about prices and availability, then sends the homeowner a summary. It only calls shops that show up in local search. A shop that will not give a price range drops out of the comparison.</p>
      <p class="body-lg">Whoever answers your phone, and whatever your Google listing says, is now part of your sales team. The Phone Test checks both.</p>
      <p class="ph-source">Source: <a href={ASK_FOR_ME_SOURCE.url} rel="noopener" target="_blank">{ASK_FOR_ME_SOURCE.label}</a></p>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="what-we-test">
  <div class="container">
    <div class="ph-head">
      <div><p class="ph-kicker">WHAT WE TEST</p><h2 id="what-we-test" class="heading-lg">{RUBRIC_CHECK_COUNT} checks. 100 points.</h2></div>
      <p>The same calls and the same script for every shop, so the score means something.</p>
    </div>
    <div class="ph-rubric">
      {rubric.map((s) => (
        <article class="ph-rubric-card">
          <div class="ph-rubric-top"><b class="dia-num" aria-hidden="true"><em>{s.key}</em></b><span>{s.points} pts</span></div>
          <h3>{s.name}</h3>
          <p>{s.why}</p>
          <ul>{s.checks.map((c) => <li>{c}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="how-it-works">
  <div class="container">
    <div class="ph-head"><div><p class="ph-kicker">HOW IT WORKS</p><h2 id="how-it-works" class="heading-lg">Test. Show. You decide.</h2></div></div>
    <div class="ph-steps">
      <article><span>01 / WE TEST</span><h3>You don't do anything.</h3><p>Same calls, same script, every shop. We use a real name and number and never book a fake job.</p></article>
      <article><span>02 / WE SHOW YOU</span><h3>One page, real times.</h3><p>Your score, your three biggest leaks with the clock times, and what each one costs at your numbers.</p></article>
      <article><span>03 / YOU DECIDE</span><h3>Fix it or have us fix it.</h3><p>Use the list yourself, or we set it up and run it at the prices below. The score is yours either way.</p></article>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="pricing">
  <div class="container">
    <div class="ph-head">
      <div><p class="ph-kicker">PRICES ON THE PAGE</p><h2 id="pricing" class="heading-lg">Four steps. Take only the next one.</h2></div>
      <a class="text-link" href="/services">Full details ↗</a>
    </div>
    <ol class="ph-ladder">
      {ladder.map((s) => (
        <li class="ph-rung">
          <span class="ph-rung-no">STEP {s.rung}</span>
          <h3><a href={serviceHref(s)}>{s.name}</a></h3>
          <strong class="ph-rung-price">{s.price}</strong>
          <p>{s.tagline}</p>
        </li>
      ))}
    </ol>
    {addOn && <p class="ph-addon"><strong>Add-on:</strong> <a href={serviceHref(addOn)}>{addOn.name}</a>, {addOn.price}. Open estimates from the last 90 days, followed up until they book or die honestly.</p>}
  </div>
</section>

<section class="section" aria-labelledby="ads-gate">
  <div class="container ph-split">
    <div class="ph-gate">
      <span>THE 80-POINT RULE</span>
      <p>We won't run your ads into a phone nobody answers.</p>
    </div>
    <div>
      <p class="ph-kicker">BEFORE YOU BUY ADS</p>
      <h2 id="ads-gate" class="heading-lg">Fix the front door first.</h2>
      <p class="body-lg">Ads buy calls and clicks. If the calls go to voicemail and the forms wait a day, the ads take the blame for a front door problem. We only take an ads client after the Phone Test scores 80 or higher.</p>
      <a class="text-link" href="/marketing">See the ads plan ↗</a>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="who">
  <div class="container ph-split">
    <div>
      <p class="ph-kicker">LOCAL, NOT A PAGE FARM</p>
      <h2 id="who" class="heading-lg">One person you can call.</h2>
      <p class="body-lg">Arkansas Automated is run by Andre Brassfield in Fort Smith. Before this he ran sales for a home improvement financing platform and its contractor network, and built a roofing company from zero. He runs every Phone Test himself.</p>
      <a class="text-link" href="/about">More about Dre ↗</a>
    </div>
    <div class="ph-local">
      <img class="ph-badge" src="/brand/badge-reverse.svg" alt="" width="120" height="120" decoding="async" />
      <span>WHO IT'S FOR</span>
      <p>Roofing, HVAC, plumbing, garage door, concrete and painting shops that get work from Google and the phone.</p>
      <small>Not for franchise locations with corporate marketing, or owners who want a person answering every call live.</small>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="faq">
  <div class="container ph-faq">
    <div><p class="ph-kicker">QUESTIONS OWNERS ASK FIRST</p><h2 id="faq" class="heading-lg">Straight answers.</h2></div>
    <div>{homeFaqs.map((f) => <details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</section>

<section class="section section-tint" id="get-the-test" aria-labelledby="get-test-title">
  <div class="container ph-split ph-final">
    <div>
      <p class="ph-kicker">FREE, WITHIN 3 DAYS</p>
      <h2 id="get-test-title" class="heading-lg">Find out what your customers hear.</h2>
      <p class="body-lg">Business name, your mobile and your town. That is the whole form. We text or call to confirm, run the test, and walk you through the score in 15 minutes.</p>
      <p class="ph-under">Rather pick a time now? <a href={BOOK_CALL_URL} data-cta="final-book">Ask for a 15-minute call</a>.</p>
    </div>
    <PhoneTestForm formId="home-phone-test" placement="home-final" />
  </div>
</section>

<style>
  .ph-hero { position: relative; overflow: hidden; background: var(--bg-primary); padding: clamp(3.5rem, 7vw, 7rem) 0; border-bottom: 1px solid var(--line); }
  .ph-hero-grid, .ph-split, .ph-faq { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 6vw, 5.5rem); align-items: center; position: relative; }
  .ph-kicker { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.15em; color: var(--accent); margin-bottom: 1.1rem; }
  .ph-hero h1 { max-width: 13ch; font-size: clamp(2.8rem, 5.6vw, 5.4rem); line-height: 1; letter-spacing: -0.05em; }
  .ph-hero h1 em { font-style: normal; color: var(--signal); }
  .ph-lede { max-width: 54ch; font-size: clamp(1.08rem, 1.7vw, 1.28rem); line-height: 1.58; margin: 1.8rem 0; color: var(--text-secondary); }
  .ph-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ph-under { margin-top: 1.4rem; font-size: 0.92rem; color: var(--text-muted); }
  .ph-under a { color: var(--text-primary); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .ph-hero-mark { position: absolute; right: -9vw; top: 50%; transform: translateY(-50%); width: min(62vw, 860px); opacity: 0.06; pointer-events: none; --signal: var(--ink); }
  .ph-hero-mark svg { width: 100%; height: auto; }
  .ph-strip { background: var(--ink); color: var(--ink-on); padding: 1.1rem 0; }
  .ph-strip-inner { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8rem; letter-spacing: 0.14em; font-weight: 800; }
  .ph-split h2 { max-width: 16ch; }
  .ph-split .body-lg { margin-bottom: 1rem; max-width: 56ch; }
  .ph-source { font-size: 0.82rem; color: var(--text-muted); }
  .ph-source a { text-decoration: underline; text-underline-offset: 3px; }
  .ph-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .ph-head > p { max-width: 36ch; color: var(--text-secondary); }
  .ph-head .text-link { white-space: nowrap; }
  .ph-rubric { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .ph-rubric-card { background: var(--bg-secondary); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.6rem; }
  .ph-rubric-top { display: flex; align-items: center; justify-content: space-between; }
  .ph-rubric-top span { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; color: var(--accent); }
  .ph-rubric-card h3 { font-size: 1.3rem; margin: 1.2rem 0 0.6rem; }
  .ph-rubric-card p { color: var(--text-secondary); font-size: 0.93rem; margin-bottom: 0.9rem; }
  .ph-rubric-card ul { list-style: none; border-top: 1px solid var(--line); }
  .ph-rubric-card li { font-size: 0.88rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .ph-steps { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .ph-steps article { padding: 2rem 2rem 1rem 0; border-right: 1px solid var(--line); }
  .ph-steps article + article { padding-left: 2rem; }
  .ph-steps article:last-child { border: 0; }
  .ph-steps span { font-size: 0.75rem; color: var(--accent); font-weight: 800; }
  .ph-steps h3 { font-size: 1.4rem; margin: 1.3rem 0 0.7rem; }
  .ph-steps p { color: var(--text-secondary); }
  .ph-ladder { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .ph-rung { background: var(--bg-secondary); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.6rem; display: flex; flex-direction: column; }
  .ph-rung:first-child { background: var(--ink); color: var(--ink-on); border-color: var(--ink); }
  .ph-rung:first-child p { color: rgba(246, 241, 231, 0.8); }
  .ph-rung-no { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; color: var(--accent); }
  .ph-rung:first-child .ph-rung-no, .ph-rung:first-child .ph-rung-price { color: var(--signal); }
  .ph-rung h3 { font-size: 1.35rem; margin: 0.9rem 0 0.4rem; }
  .ph-rung h3 a:hover { text-decoration: underline; }
  .ph-rung-price { font-size: 1.05rem; color: var(--accent); margin-bottom: 0.8rem; }
  .ph-rung p { color: var(--text-secondary); font-size: 0.92rem; }
  .ph-addon { margin-top: 1.2rem; color: var(--text-secondary); font-size: 0.95rem; }
  .ph-addon a { text-decoration: underline; text-underline-offset: 3px; }
  .ph-gate { padding: 3rem; background: var(--bg-tertiary); border-radius: var(--radius-lg); min-height: 18rem; display: flex; flex-direction: column; justify-content: space-between; }
  .ph-gate span { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.14em; color: var(--accent); }
  .ph-gate span::after { content: ""; display: block; width: 3rem; height: 4px; background: var(--signal); margin-top: 0.9rem; }
  .ph-gate p { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.9rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.03em; }
  .ph-local { position: relative; background: var(--pine); color: var(--ink-on); border-radius: var(--radius-lg); padding: 3rem; }
  .ph-local span { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.14em; color: var(--signal); }
  .ph-local p { font-family: var(--font-heading); font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 700; line-height: 1.3; margin: 1.3rem 0; padding-right: clamp(0rem, 8vw, 7rem); }
  .ph-local small { color: rgba(246, 241, 231, 0.75); }
  .ph-badge { position: absolute; right: 2rem; top: 2rem; width: clamp(80px, 9vw, 120px); height: auto; }
  .ph-faq { align-items: start; }
  .ph-faq .faq-item { border-top: 1px solid var(--line); }
  .ph-final { align-items: start; }
  .dia { display: inline-block; width: 0.55em; height: 0.55em; background: var(--signal); transform: rotate(45deg); margin-right: 0.7em; vertical-align: 0.08em; }
  .dia-num { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; background: var(--signal); transform: rotate(45deg); border-radius: 3px; margin: 0.3rem 0.2rem; }
  .dia-num em { transform: rotate(-45deg); font-style: normal; color: var(--ink); font-size: 0.85rem; }
  @media (max-width: 1000px) {
    .ph-rubric, .ph-ladder { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .ph-hero-grid, .ph-split, .ph-faq { grid-template-columns: 1fr; }
    .ph-hero-mark { right: -30vw; width: 110vw; top: auto; bottom: -20vw; transform: none; }
    .ph-badge { display: none; }
  }
  @media (max-width: 600px) {
    .ph-hero { padding: 3rem 0; }
    .ph-hero h1 { font-size: clamp(2.6rem, 11.5vw, 4rem); }
    .ph-rubric, .ph-ladder, .ph-steps { grid-template-columns: 1fr; }
    .ph-steps article, .ph-steps article + article { padding: 1.5rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .ph-head { display: block; }
    .ph-head > p { margin-top: 1rem; }
    .ph-actions .btn { width: 100%; justify-content: center; }
    .ph-strip-inner { font-size: 0.68rem; }
    .ph-gate, .ph-local { padding: 2rem; }
  }
</style>
